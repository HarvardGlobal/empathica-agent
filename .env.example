# Empathica — environment variable reference
# Copy this file to .env for local development.
# Never commit .env to version control.
# In production, supply these via Google Secret Manager or Vertex AI env config.

# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true          # set to "false" to use API key auth locally

# Staging bucket used by adk deploy (must exist in your project)
STAGING_BUCKET=gs://your-staging-bucket

# ── Model ─────────────────────────────────────────────────────────────────────
# Override the Gemini model used by both agents.
# Default (if unset): gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# ── API key auth (local dev only — use Vertex AI auth in production) ──────────
# Only needed when GOOGLE_GENAI_USE_VERTEXAI=false
# In production, use a service account with Vertex AI permissions instead.
GOOGLE_API_KEY=

# ── Tool backends ─────────────────────────────────────────────────────────────
# Leave empty to run with stub responses (tools degrade gracefully).
# Set these to real service URLs to enable live data retrieval.

# Drug knowledge API (DailyMed / openFDA ingestion service)
DRUG_KNOWLEDGE_API_URL=

# Patient context / EHR integration service
PATIENT_CONTEXT_API_URL=

# Literature retrieval / RAG service
LITERATURE_RETRIEVAL_API_URL=

# ── Application defaults ──────────────────────────────────────────────────────
DEFAULT_LITERACY_LEVEL=moderate
